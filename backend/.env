# backend/.env

# Environnement
ENVIRONMENT=development
DEBUG=true

# Base de données
DATABASE_URL=postgresql://immo_user:immo_password_2024@localhost:5432/immo_db

# JWT (Changez cette clé !)
SECRET_KEY=votre-secret-key-tres-longue-et-complexe-minimum-32-caracteres-2024
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5242880

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
# Clés générées automatiquement par scripts/init_env.py — conservez-les stables.

