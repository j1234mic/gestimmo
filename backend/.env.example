# Copiez ce fichier vers backend/.env puis adaptez les valeurs.
# Le fichier .env n'est pas versionné.
# Astuce : `python scripts/init_env.py` crée ce fichier depuis cet exemple et
# génère automatiquement SECRET_KEY et SECURE_ID_KEY (voir --help).

# Environnement
ENVIRONMENT=development
DEBUG=true

# Base de données
# Hôte `postgres` = service docker-compose. En local hors Docker, utilisez localhost :
#   python scripts/init_env.py --db-host localhost
# Le même fichier est lu par docker compose, qui impose de son côté l'hôte
# `postgres` dans le conteneur : mettre localhost ici n'affecte donc que l'API
# lancée sur la machine hôte. Pour une base externe au compose, utilisez
# DATABASE_URL_DOCKER (lu par docker-compose.yml uniquement).
DATABASE_URL=postgresql://immo_user:immo_password_2024@postgres:5432/immo_db
# DATABASE_URL_DOCKER=postgresql://immo_user:immo_password_2024@postgres:5432/immo_db
AUTO_CREATE_TABLES=true

# JWT — générez une clé aléatoire stable (minimum 32 caractères)
SECRET_KEY=changez-cette-cle-secrete-minimum-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Chiffrement des identifiants publics (secure_id, architecture hexagonale).
# Clé Fernet (44 caractères base64 url-safe). À générer une fois et à conserver
# stable : python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Sans cette clé, une clé de session éphémère est utilisée (non persistante).
SECURE_ID_KEY=

# Rate limiting global (par adresse IP)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60
RATE_LIMIT_ENABLED=true

# CORS (liste séparée par des virgules). `*` désactive les credentials.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8000

# Upload
UPLOAD_DIR=uploads
PRIVATE_UPLOAD_DIR=private_uploads
BACKUP_DIR=backups
MAX_UPLOAD_SIZE=5242880

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Optionnel — SMS / IA / Stripe
# SMS_WEBHOOK_URL=
# SMS_WEBHOOK_TOKEN=
# AI_CHAT_BASE_URL=
# AI_CHAT_MODEL=
# AI_CHAT_API_KEY=
# AI_CHAT_TIMEOUT_SECONDS=25
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
