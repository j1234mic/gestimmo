# backend/.env

# Environnement
ENVIRONMENT=development
DEBUG=True

# Base de données PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/immo_db

# Alternative SQLite pour développement rapide
# DATABASE_URL=sqlite:///./immo.db

# Serveur
HOST=0.0.0.0
PORT=8000

# Upload
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE=5242880  # 5MB

# JWT (pour plus tard)
SECRET_KEY=votre-secret-key-tres-longue-et-securisee
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173